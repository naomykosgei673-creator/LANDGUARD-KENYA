# ─── Database ────────────────────────────────────────────────────────────────
# Dev default (works today, no install). For production switch the Prisma
# provider to "postgresql" and use a postgres URL, e.g.:
#   DATABASE_URL="postgresql://landguard:landguard@localhost:5432/landguard?schema=public"
DATABASE_URL="file:./dev.db"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ─── Auth / JWT ──────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-in-production-please-use-64-random-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-in-production-please-use-64-random-chars
JWT_ACCESS_TTL=900            # 15 minutes (seconds)
JWT_REFRESH_TTL=604800        # 7 days (seconds)
TWO_FACTOR_ISSUER=LandGuard Kenya

# ─── Payments (sandbox by default — real creds go here in production) ──────────
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://localhost:4000/api/payments/mpesa/callback
CARD_GATEWAY_KEY=
PAYMENTS_SANDBOX=true

# ─── Storage (Firebase) ──────────────────────────────────────────────────────
FIREBASE_STORAGE_BUCKET=
STORAGE_DRIVER=local          # "local" (dev) or "firebase" (prod)

# ─── Maps ────────────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ─── ML fraud-scoring microservice (Python/Flask) ────────────────────────────
ML_ENABLED=true
ML_SERVICE_URL=http://localhost:5001
ML_TIMEOUT_MS=2500
